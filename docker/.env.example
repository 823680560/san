# ============================================================
# 环卫行业智能问答系统 - 环境变量配置示例
# ============================================================
# 使用方式：复制为 .env 文件，修改对应配置后 docker compose up
# cp .env.example .env && docker compose up -d
# ============================================================

# ========== 方案一：Ollama 本地开源模型 ==========
# 可选模型：glm-4-9b-chat:latest 或 Llama-3.1-8B-Instruct
# LLM_MODEL=Llama-3.1-8B-Instruct
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://ollama:11434/v1

# ========== 方案二：DeepSeek 商用 API ==========
LLM_MODEL=deepseek-chat
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1

# ========== HuggingFace 镜像（国内部署建议取消注释）==========
# HF_ENDPOINT=https://hf-mirror.com

# ========== 嵌入模型配置（HuggingFace 本地加载 bge-m3）==========
EMBEDDING_SERVICE=huggingface
EMBEDDING_MODEL_PATH=/app/models/bge-m3

# ========== 如果用 Ollama 部署 bge-m3（替代上方 HuggingFace 配置）==========
# EMBEDDING_SERVICE=ollama
# EMBEDDING_MODEL=bge-m3
# OLLAMA_BASE_URL=http://ollama:11434

# ========== 评估模型配置（可与生成模型不同）==========
EVAL_LLM_MODEL=deepseek-chat
EVAL_LLM_API_KEY=sk-your-api-key-here
EVAL_LLM_BASE_URL=https://api.deepseek.com/v1

# ========== SQL生成模型配置（可与生成模型不同）=========
SQL_ROUTER_MODEL=deepseek-chat
SQL_ROUTER_API_KEY=sk-your-api-key-here
SQL_ROUTER_BASE_URL=https://api.deepseek.com/v1
